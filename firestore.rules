rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParent(familyId) {
      return signedIn() && request.auth.uid == familyId;
    }

    function isChild(familyId) {
      return signedIn()
        && request.auth.token.keys().hasAll(["role", "familyId", "childProfileId"])
        && request.auth.token.role == "child"
        && request.auth.token.familyId == familyId
        && request.auth.token.childProfileId is string;
    }

    function isFamilyMember(familyId) {
      return isParent(familyId) || isChild(familyId);
    }

    function authChildProfileId() {
      return request.auth.token.childProfileId;
    }

    function requestMatchesFamily(familyId) {
      return request.resource.data.familyId == familyId;
    }

    function requestMatchesChild(familyId, childProfileId) {
      return requestMatchesFamily(familyId)
        && request.resource.data.childProfileId == childProfileId;
    }

    function requestKeepsFamilyId() {
      return request.resource.data.keys().hasAny(["familyId"])
        && resource.data.keys().hasAny(["familyId"])
        && request.resource.data.familyId == resource.data.familyId;
    }

    function requestKeepsChildProfileId() {
      return request.resource.data.keys().hasAny(["childProfileId"])
        && resource.data.keys().hasAny(["childProfileId"])
        && request.resource.data.childProfileId == resource.data.childProfileId;
    }

    function nullOrAbsent(field) {
      return !request.resource.data.keys().hasAny([field]) || request.resource.data[field] == null;
    }

    function hasNonBlankText(field) {
      return request.resource.data[field] is string
        && request.resource.data[field].matches(".*\\S.*");
    }

    function optionalNonBlankText(field) {
      return nullOrAbsent(field) || hasNonBlankText(field);
    }

    function requestKeepsField(field) {
      return request.resource.data.keys().hasAny([field])
        && resource.data.keys().hasAny([field])
        && request.resource.data[field] == resource.data[field];
    }

    function settlementKeys() {
      return [
        "familyId",
        "childProfileId",
        "amountCents",
        "concept",
        "status",
        "requestedAt",
        "paidByParentAt",
        "confirmedByChildAt",
        "settlementTransactionId",
      ];
    }

    function settlementRequestIsValid(familyId) {
      return request.resource.data.keys().hasAll([
          "familyId",
          "childProfileId",
          "amountCents",
          "concept",
          "status",
          "requestedAt",
        ])
        && requestMatchesFamily(familyId)
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && request.resource.data.concept is string
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.status == "Requested"
        && nullOrAbsent("paidByParentAt")
        && nullOrAbsent("confirmedByChildAt")
        && nullOrAbsent("settlementTransactionId");
    }

    function taskTemplateWriteIsValid(familyId) {
      return request.resource.data.keys().hasAll([
          "familyId",
          "title",
          "description",
          "iconKey",
          "defaultValueCents",
          "requiresPhoto",
          "source",
          "createdAt",
          "updatedAt",
        ])
        && requestMatchesFamily(familyId)
        && hasNonBlankText("title")
        && hasNonBlankText("description")
        && hasNonBlankText("iconKey")
        && request.resource.data.defaultValueCents is int
        && request.resource.data.defaultValueCents > 0
        && request.resource.data.requiresPhoto is bool
        && request.resource.data.source is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function taskAssignmentWriteIsValid(familyId) {
      return request.resource.data.keys().hasAll([
          "familyId",
          "taskTemplateId",
          "title",
          "rewardCents",
          "requiresPhoto",
          "childProfileIds",
          "recurrence",
          "dueAt",
          "active",
          "createdAt",
          "updatedAt",
        ])
        && requestMatchesFamily(familyId)
        && request.resource.data.taskTemplateId is string
        && request.resource.data.taskTemplateId.size() > 0
        && hasNonBlankText("title")
        && request.resource.data.rewardCents is int
        && request.resource.data.rewardCents > 0
        && request.resource.data.requiresPhoto is bool
        && request.resource.data.childProfileIds is list
        && request.resource.data.childProfileIds.size() > 0
        && request.resource.data.recurrence in ["Once", "Daily", "Weekly", "Custom"]
        && request.resource.data.dueAt is timestamp
        && (
          (
            request.resource.data.recurrence == "Custom"
            && request.resource.data.customIntervalDays is int
            && request.resource.data.customIntervalDays >= 1
          )
          || (
            request.resource.data.recurrence != "Custom"
            && nullOrAbsent("customIntervalDays")
          )
        )
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function childSettlementRequestIsValid(familyId) {
      return isChild(familyId)
        && request.resource.data.childProfileId == authChildProfileId()
        && settlementRequestIsValid(familyId);
    }

    function childSettlementConfirmationIsValid(familyId) {
      return isChild(familyId)
        && resource.data.childProfileId == authChildProfileId()
        && resource.data.status == "PaidByParent"
        && request.resource.data.status == "ConfirmedByChild"
        && requestKeepsFamilyId()
        && requestKeepsChildProfileId()
        && request.resource.data.amountCents == resource.data.amountCents
        && request.resource.data.concept == resource.data.concept
        && request.resource.data.requestedAt == resource.data.requestedAt
        && request.resource.data.paidByParentAt == resource.data.paidByParentAt
        && request.resource.data.confirmedByChildAt is timestamp
        && request.resource.data.settlementTransactionId is string;
    }

    function taskInstanceKeys() {
      return [
        "familyId",
        "taskAssignmentId",
        "taskTemplateId",
        "childProfileId",
        "title",
        "rewardCents",
        "requiresPhoto",
        "status",
        "dueAt",
        "periodKey",
        "createdAt",
        "updatedAt",
        "submittedAt",
        "reviewedAt",
        "expiredAt",
        "photoEvidenceUri",
        "approvedRewardCents",
        "approvalTransactionId",
        "rejectionReason",
      ];
    }

    function taskInstanceSnapshotIsUnchanged() {
      return requestKeepsField("familyId")
        && requestKeepsField("taskAssignmentId")
        && requestKeepsField("taskTemplateId")
        && requestKeepsField("childProfileId")
        && requestKeepsField("title")
        && requestKeepsField("rewardCents")
        && requestKeepsField("requiresPhoto")
        && requestKeepsField("dueAt")
        && requestKeepsField("periodKey")
        && requestKeepsField("createdAt");
    }

    function taskInstanceSubmissionActorIsValid(familyId) {
      return isParent(familyId)
        || (isChild(familyId) && resource.data.childProfileId == authChildProfileId());
    }

    function taskInstanceSubmissionIsValid(familyId) {
      return taskInstanceSubmissionActorIsValid(familyId)
        && request.resource.data.keys().hasOnly(taskInstanceKeys())
        && resource.data.status in ["Pending", "Rejected"]
        && request.resource.data.status == "Submitted"
        && taskInstanceSnapshotIsUnchanged()
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.submittedAt is timestamp
        && nullOrAbsent("reviewedAt")
        && nullOrAbsent("expiredAt")
        && nullOrAbsent("approvedRewardCents")
        && nullOrAbsent("approvalTransactionId")
        && nullOrAbsent("rejectionReason")
        && optionalNonBlankText("photoEvidenceUri")
        && (!resource.data.requiresPhoto || hasNonBlankText("photoEvidenceUri"));
    }

    function taskInstanceReviewBaseIsValid(familyId) {
      return isParent(familyId)
        && request.resource.data.keys().hasOnly(taskInstanceKeys())
        && resource.data.status == "Submitted"
        && taskInstanceSnapshotIsUnchanged()
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.photoEvidenceUri == resource.data.photoEvidenceUri
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.reviewedAt is timestamp
        && nullOrAbsent("expiredAt");
    }

    function taskInstanceApprovalFieldsAreValid() {
      return request.resource.data.status == "Approved"
        && request.resource.data.approvedRewardCents is int
        && request.resource.data.approvedRewardCents > 0
        && hasNonBlankText("approvalTransactionId")
        && nullOrAbsent("rejectionReason");
    }

    function taskInstanceRejectionFieldsAreValid() {
      return request.resource.data.status == "Rejected"
        && hasNonBlankText("rejectionReason")
        && nullOrAbsent("approvedRewardCents")
        && nullOrAbsent("approvalTransactionId");
    }

    function taskInstanceReviewIsValid(familyId) {
      return taskInstanceReviewBaseIsValid(familyId)
        && (
          taskInstanceApprovalFieldsAreValid()
          || taskInstanceRejectionFieldsAreValid()
        );
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isParent(familyId) && requestMatchesFamily(familyId);
      allow update: if isParent(familyId) && requestKeepsFamilyId();
      allow delete: if false;

      match /allowanceRules/{ruleId} {
        allow read: if isParent(familyId)
          || (isChild(familyId) && resource.data.childProfileId == authChildProfileId());
        allow create: if isParent(familyId) && requestMatchesFamily(familyId);
        allow update: if isParent(familyId) && requestKeepsFamilyId() && requestKeepsChildProfileId();
        allow delete: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isParent(familyId)
          || (isChild(familyId) && resource.data.childProfileId == authChildProfileId());
        allow create: if isParent(familyId) && settlementRequestIsValid(familyId);
        allow create: if childSettlementRequestIsValid(familyId);
        allow update: if isParent(familyId) && requestKeepsFamilyId() && requestKeepsChildProfileId();
        allow update: if childSettlementConfirmationIsValid(familyId);
        allow delete: if false;
      }

      match /taskTemplates/{templateId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isParent(familyId) && taskTemplateWriteIsValid(familyId);
        allow update: if isParent(familyId) && requestKeepsFamilyId() && taskTemplateWriteIsValid(familyId);
        allow delete: if false;
      }

      match /taskAssignments/{assignmentId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isParent(familyId) && taskAssignmentWriteIsValid(familyId);
        allow update: if isParent(familyId) && requestKeepsFamilyId() && taskAssignmentWriteIsValid(familyId);
        allow delete: if false;
      }

      match /taskInstances/{instanceId} {
        allow read: if isParent(familyId)
          || (isChild(familyId) && resource.data.childProfileId == authChildProfileId());
        allow create, delete: if false;
        allow update: if request.resource.data.status == "Submitted"
          && taskInstanceSubmissionIsValid(familyId);
        allow update: if request.resource.data.status in ["Approved", "Rejected"]
          && taskInstanceReviewIsValid(familyId);
      }

      match /childProfiles/{childProfileId} {
        allow read: if isParent(familyId)
          || (isChild(familyId) && childProfileId == authChildProfileId());
        allow create, update: if isParent(familyId) && requestMatchesChild(familyId, childProfileId);
        allow delete: if false;
      }

      match /childDevices/{deviceId} {
        allow read: if isParent(familyId)
          || (isChild(familyId) && resource.data.childProfileId == authChildProfileId());
        allow create, update: if isParent(familyId) && requestMatchesFamily(familyId);
        allow delete: if false;
      }

      match /pairingSessions/{pairingCode} {
        allow read, write: if isParent(familyId) && requestMatchesFamily(familyId);
      }

      match /ledgerTransactions/{transactionId} {
        allow read: if isParent(familyId)
          || (isChild(familyId) && resource.data.childProfileId == authChildProfileId());
        allow create: if isParent(familyId) && requestMatchesFamily(familyId);
        allow update, delete: if false;
      }
    }
  }
}
